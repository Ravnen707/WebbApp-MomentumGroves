<dialog id="training-group-dialog" class="drink-dialog" aria-labelledby="training-group-heading">
    <form class="dialog-inner">
        <h2 id="training-group-heading"></h2>
        <label>Group name<input name="groupName" required maxlength="80"></label>
        <div class="modal-actions">
            <button type="button" class="btn secondary" data-cancel-group>Cancel</button>
            <button type="submit" class="btn">Save group</button>
        </div>
    </form>
</dialog>
