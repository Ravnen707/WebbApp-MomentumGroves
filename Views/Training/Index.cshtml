@{ ViewData["Title"] = "Training"; }
@section Styles {
    <link rel="stylesheet" href="~/css/training.css" asp-append-version="true"/>
}
<div class="heading">
    <div><p class="eyebrow">TRAINING</p>
        <h1>Your training programmes</h1>
        <p class="muted">Create programmes and track your training progress.</p></div>
    <button type="button" class="btn secondary" id="reload-training">Reload programmes</button>
</div>
<div class="training-program-tabs">
    <div id="training-program-tabs" class="training-program-tabs" role="tablist" aria-label="Programme groups"></div>
    <button type="button" class="btn secondary" id="training-add-group">+ New programme group</button>
</div>
<div class="training-program-actions">
    <button type="button" id="training-rename-group" class="btn secondary">Rename group</button>
    <button type="button" id="training-dashboard-group" class="btn secondary"
        aria-pressed="false">Show this group on dashboard</button>
    <button type="button" id="training-add-box" class="btn secondary">+ Add programme</button>
</div>
<div id="training-days" class="training-stack"></div>
<partial name="~/Views/Training/Modal/_TrainingGroupModal.cshtml" />
<partial name="~/Views/Training/Modal/_TrainingImageModal.cshtml" />
<div class="training-footer">
    <button id="save-workouts" class="btn">Save training programme</button>
    <span class="muted" id="save-message" role="status"></span></div>
<section class="training-development" id="training-progress" hidden aria-label="Training progress">
    <div class="training-development-heading">
        <div><h2>Training progress</h2>
            <p class="muted">Track completed workouts and exercise progress over time.</p></div>
    </div>
    <div class="training-progress-stats" id="training-progress-stats"></div>
    <div class="training-development-grid">
        <section class="panel training-development-card"><h3>Training activity</h3>
            <p class="muted tiny">Completed training days by ISO week (Monday to Sunday) · last 8 weeks</p>
            <div id="training-progress-weeks" class="training-progress-weeks"></div>
        </section>
        <section class="panel training-development-card"><h3>Exercise progress</h3>
            <div class="training-progress-filters">
                <label>Category
                    <select id="training-progress-category" aria-label="Choose a training category"></select>
                </label>
                <label>Programme
                    <select id="training-progress-topic" aria-label="Choose a training programme"></select>
                </label>
                <label>Exercise<select id="training-progress-exercise" aria-label="Choose an exercise"></select></label>
            </div>
            <div id="training-progress-strength" class="training-progress-strength muted"
                aria-live="polite">Choose an exercise to see your progress.
            </div>
        </section>
    </div>
</section>
