<dialog id="nutrition-zones-dialog" class="info-dialog" aria-labelledby="nutrition-zones-heading">
    <div class="dialog-inner">
        <div class="modal-heading">
            <button type="button" class="modal-x" data-close-dialog aria-label="Close nutrition ranges">×</button>
        </div>
        <div class="nutrition-zones" aria-labelledby="nutrition-zones-heading">
            <h2 id="nutrition-zones-heading">Your daily nutrition ranges</h2>
            <div class="table-scroll">
                <table class="zone-table">
                    <thead>
                    <tr>
                        <th>Nutrient</th>
                        <th class="zone-low">Yellow – Low</th>
                        <th class="zone-good">Green – Good</th>
                        <th class="zone-high">Yellow – High</th>
                        <th class="zone-over">Red – Above target</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td><strong>Calories</strong></td>
                        <td>Under 2,150</td>
                        <td>2,150–2,550</td>
                        <td>2,551–2,700</td>
                        <td>Over 2,700</td>
                    </tr>
                    <tr>
                        <td><strong>Protein</strong></td>
                        <td>Under 130 g</td>
                        <td>130–170 g</td>
                        <td>171–190 g</td>
                        <td>Over 190 g</td>
                    </tr>
                    <tr>
                        <td><strong>Carbohydrates</strong></td>
                        <td>Under 200 g</td>
                        <td>200–320 g</td>
                        <td>321–350 g</td>
                        <td>Over 350 g</td>
                    </tr>
                    <tr>
                        <td><strong>Fat</strong></td>
                        <td>Under 60 g</td>
                        <td>60–90 g</td>
                        <td>91–105 g</td>
                        <td>Over 105 g</td>
                    </tr>
                    <tr>
                        <td><strong>Fibre</strong></td>
                        <td>Under 25 g</td>
                        <td>25–35 g</td>
                        <td>Over 35 g is OK</td>
                        <td>No upper target</td>
                    </tr>
                    </tbody>
                </table>
            </div>
            <p class="muted tiny">These ranges are fixed. Your personal targets from the Health & Nutrition Calculator are still shown beside today's values. On cheat days, exceeding a personal target is highlighted in orange.</p>
        </div>
    </div>
</dialog>