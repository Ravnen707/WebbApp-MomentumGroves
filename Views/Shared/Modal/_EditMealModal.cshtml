<dialog id="edit-meal-dialog" class="drink-dialog" aria-labelledby="edit-meal-heading">
    <div class="dialog-inner">
        <div class="section-head"><h2 id="edit-meal-heading">Edit entry</h2>
            <button type="button" class="btn secondary" id="close-edit-meal" aria-label="Close">×</button>
        </div>
        <form id="edit-meal-form">
            <label>Name / description<input name="name" required maxlength="200"></label>
            <div id="edit-meal-ingredient-list" class="food-ingredient-list"></div>
            <input name="grams" type="hidden">
            <details id="edit-meal-details">
                <summary>Nutrition totals and details</summary>
                <div class="form-grid">
                    <label>Calories (kcal)<input name="kcal" type="text" inputmode="decimal" min="0" step="any"
                                                 required></label>
                    <label>Protein (g)<input name="protein" type="text" inputmode="decimal" min="0" step="any"
                                             required></label>
                    <label>Carbohydrates (g)<input name="carbs" type="text" inputmode="decimal" min="0" step="any"
                                                   required></label>
                    <label>Fat (g)<input name="fat" type="text" inputmode="decimal" min="0" step="any" required></label>
                    <label>Fibre (g)<input name="fiber" type="text" inputmode="decimal" min="0" step="any"
                                           placeholder="Optional"></label>
                </div>
                <label>Ingredients / contents (text, optional)<textarea name="ingredients" rows="3"
                                                                        placeholder="e.g. chicken 150 g, pasta 100 g"></textarea></label>
                <label>Notes<textarea name="notes" rows="3"></textarea></label>
            </details>
            <p class="muted tiny" id="edit-meal-message" role="status"></p>
            <div class="modal-actions">
                <button type="button" class="btn secondary" id="cancel-edit-meal">Cancel</button>
                <button type="submit" class="btn">Save changes</button>
            </div>
        </form>
    </div>
</dialog>