<dialog id="copy-meal-dialog" class="drink-dialog" aria-labelledby="copy-meal-heading">
        <div class="dialog-inner">
                <div class="section-head"><h2 id="copy-meal-heading">Copy a previous meal</h2>
                        <button type="button" class="btn secondary" id="close-copy-meal" aria-label="Close">×</button>
                </div>
                <div class="form-grid"><label>Date<input type="date" id="copy-date"></label>
                    <label>Meal<select id="copy-meal">
                                        <option value="">Choose a date first</option>
                                </select></label></div>
                <p class="muted tiny">The selected meal is copied into the food form. It is saved when you press
                        Save.</p>
                <p class="muted tiny" id="copy-message" role="status"></p>
                <div class="modal-actions">
                        <button type="button" class="btn secondary" id="cancel-copy-meal">Cancel</button>
                        <button type="button" class="btn" id="copy-meal-button">Continue to meal →</button>
                </div>
        </div>
</dialog>
