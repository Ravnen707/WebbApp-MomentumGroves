@model MomentumGroves.Models.DatabaseInitializationStatus
<div id="database-setup-overlay" class="database-setup-overlay">
    <section class="database-setup-dialog" role="dialog" aria-modal="true"
             aria-labelledby="database-setup-title" aria-describedby="database-setup-description">
        <h2 id="database-setup-title">Database initialization</h2>
        @if (ViewData.ModelState.IsValid && !Model.RequiresLocalSetup)
        {
            <p id="database-setup-description">Both local SQLite databases are ready. Open Admin to download and install
                the DTU Frida food database.</p>
            <a class="btn" id="database-setup-admin" asp-controller="Admin" asp-action="Index">Set up Frida DB</a>
            <a class="btn secondary" asp-controller="Home" asp-action="Index">Continue to dashboard</a>
        }
        else
        {
            <p id="database-setup-description">Momentum Groves needs these local SQLite databases.</p>
            <ul id="database-setup-missing" class="database-setup-list">
                @if (Model.MomentumMissing)
                {
                    <li><code>momentum.db</code> for your app data</li>
                }
                @if (Model.FoodsMissing)
                {
                    <li><code>food_and_recipes.db</code> for your saved foods and recipes</li>
                }
            </ul>
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="database-setup-error" role="alert"></div>
            }

            <form id="database-setup-form" method="post" asp-route="SubmitDatabaseSetup">
                <input type="hidden" name="showSetupModal" value="true"/>
                <button type="submit" class="btn" id="database-setup-confirm" autofocus>Create SQLite databases</button>
            </form>
            <div id="database-setup-loading" class="loading" role="status" aria-live="polite" hidden>
                <span class="spinner" aria-hidden="true"></span>
                <div>
                    <strong>Creating SQLite databases…</strong>
                    <p>Keep this page open.</p>
                </div>
            </div>
        }
    </section>
</div>
