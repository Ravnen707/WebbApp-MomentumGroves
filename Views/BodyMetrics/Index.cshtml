@{ ViewData["Title"] = "Health & Nutrition Calculator"; }
<div class="heading">
  <div><p class="eyebrow">HEALTH & NUTRITION CALCULATOR</p>
    <h1>Calculate your daily targets</h1>
    <p class="muted">Your calculated targets are automatically used on the dashboard and in the food diary.</p></div>
</div>
<div class="two-col calculator-layout">
  <section class="panel">
    <h2>1. Your details</h2>
    <form id="calculator-form">
      <div class="form-grid">
        <label>Current weight (kg)
            <input name="weight" type="text" inputmode="decimal" min="20" max="500" step="0.1" value="0"
            required/></label>
        <label>Target weight (kg)
            <input name="targetWeight" type="text" inputmode="decimal" min="20" max="500" step="0.1" value="0"
            required/></label>
        <label>Height (cm)
            <input name="height" type="text" inputmode="decimal" min="100" max="250" step="0.1" value="0" required/>
        </label>
        <label>Age (years)
            <input name="age" type="text" inputmode="decimal" min="18" max="110" step="1" value="0" required/>
        </label>
      </div>
      <label>Calculation formula<select name="sex" required>
          <option value="" selected disabled>Choose physiology</option>
          <option value="male">Male physiology</option>
          <option value="female">Female physiology</option>
        </select></label>
      <h2>2. Activity and training</h2>
      <label class="toggle-row"><input name="includeTraining" type="checkbox"/><span>
          <strong>Include training in calorie needs</strong>
          <small>Turn off for a sedentary estimate. Your training log is unaffected.</small></span></label>
      <div id="training-settings" hidden>
          <label>Training sessions per week
              <input name="trainingDays" type="text" inputmode="decimal" min="0" max="7" step="1" value="0"/>
          </label>
        <p class="muted tiny" id="training-info"></p></div>
      <h2>3. Your weight loss and macro split</h2>
      <label>Desired daily calorie deficit<select name="deficit" required>
          <option value="" selected disabled>Select desired deficit</option>
          <option value="300">Gentle – 300 kcal</option>
          <option value="500">Moderate – 500 kcal</option>
          <option value="700">Faster – 700 kcal</option>
        </select></label>
      <div class="form-grid"><label>Protein per kg of target weight (g)<input name="proteinFactor" type="text"
          inputmode="decimal" min="0.8"
          max="2.5" step="0.1" value="0"/></label>
              <label>Calories from fat (%)
                  <input name="fatPercent" type="text" inputmode="decimal" min="15" max="45" step="1" value="0"/>
              </label>
      </div>
      <button class="btn" type="submit">Save calculation as my targets</button>
      <p class="muted tiny" id="calculator-message" role="status"></p>
    </form>
  </section>
  <section class="panel results-panel">
    <h2>4. Your results</h2>
    <div class="results-grid">
      <div class="result-box"><small>Basal metabolic rate (BMR)</small><strong id="calc-bmr">–</strong></div>
      <div class="result-box"><small>Maintenance calories (estimate)</small><strong id="calc-maintenance">–</strong>
          </div>
    </div>
    <div class="highlight-result"><small>RECOMMENDED DAILY CALORIE TARGET</small><strong id="calc-kcal">–</strong>
      <p class="muted tiny" id="calc-explanation"></p></div>
    <div class="macro-grid">
      <div><small>Protein</small><strong id="calc-protein">–</strong></div>
      <div><small>Carbohydrates</small><strong id="calc-carbs">–</strong></div>
      <div><small>Fat</small><strong id="calc-fat">–</strong></div>
    </div>
    <div class="macro-strip"><span id="macro-protein"></span><span id="macro-carbs"></span><span id="macro-fat"></span>
    </div>
    <div class="result-box"><small>Estimated weekly weight loss</small><strong id="calc-loss">–</strong></div>
    <p
        class="muted tiny">These calculations are estimates. Training sessions alone cannot determine your actual energy
        expenditure. Track your average weight over 3–4 weeks and adjust based on your progress.</p>
    <p
        class="muted tiny">Calculation: Mifflin-St Jeor, activity factor 1.20 without training and 1.20 + 0.05 per
        weekly training session when training is included. Macros: protein based on target weight, fat as a percentage
        of calories, and carbohydrates for the remainder.</p>
  </section>
</div>
