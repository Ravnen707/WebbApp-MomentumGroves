@{ ViewData["Title"] = "Walking & Running Routes"; }
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<link rel="stylesheet" href="~/css/routes.css" asp-append-version="true"/>
<div class="heading">
    <div><p class="eyebrow">ROUTES</p>
        <h1>Find walking and running routes</h1>
        <p class="muted">Search for a place, move the starting point and get suggested loop routes. Nothing is saved automatically.</p></div>
</div>
<form id="route-settings" class="route-settings" autocomplete="off">
    @Html.AntiForgeryToken()
    <div class="route-field route-location"><label for="route-address">Area or address</label>
        <div class="route-inline"><input id="route-address" placeholder="Search for a town, area or address"/>
            <button type="button" class="btn" id="route-search">Search</button>
        </div>
        <div id="route-search-results" class="route-search-results"></div>
    </div>
    <div class="route-field"><label for="route-distance">Distance (km)</label><input id="route-distance" type="number"
                                                                                     min="0.5" max="40" step="0.5"
                                                                                     value="5" required/></div>
    <div class="route-field"><label for="route-activity">Activity</label><select id="route-activity">
            <option value="walk">Walking</option>
            <option value="run">Running</option>
        </select></div>
    <div class="route-field"><label for="route-environment">Surroundings</label><select id="route-environment">
            <option value="mixed">Mixed</option>
            <option value="city">Urban</option>
            <option value="outside">Outside town</option>
        </select></div>
    <div class="route-field"><label for="route-map-style">Map</label><select id="route-map-style">
            <option value="osm">OpenStreetMap</option>
            <option value="topo">Tracestrack Topo</option>
        </select></div>
    <button type="submit" class="btn route-generate">Find loop routes</button>
</form>
<div id="route-status" class="route-status" role="status"></div>
<div class="route-layout">
    <div>
        <div id="route-map" data-tracestrack-key="@ViewBag.TracestrackKey" data-osm-tile-url="@ViewBag.OsmTileUrl"
             data-tracestrack-tile-url="@ViewBag.TracestrackTileUrl"></div>
        <p class="muted route-hint">Click the map or drag the green marker to change the starting point.</p></div>
    <aside class="route-panel"><h2>Suggested routes</h2>
        <div id="route-candidates"><p class="muted">Generate a route to see suggestions.</p></div>
        <div id="route-save-box" hidden><label for="route-name">Route name</label><input id="route-name"
                                                                                            maxlength="100"
                                                                                            placeholder="My running route"/>
            <button type="button" class="btn" id="route-save">Save route</button>
        </div>
        <hr/>
        <h2>Saved routes</h2>
        <div id="route-saved"></div>
    </aside>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script type="module" src="~/js/routes/routes.js" asp-append-version="true"></script>}
