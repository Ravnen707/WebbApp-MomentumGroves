@model MomentumGroves.Models.DatabaseInitializationStatus
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Database setup – Momentum Groves</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/modals/database-initialization.css" asp-append-version="true"/>
</head>
<body>
<partial name="~/Views/Shared/Modal/_DatabaseInitializationModal.cshtml" model="Model"/>
@if (Model.RequiresLocalSetup || !ViewData.ModelState.IsValid)
{
    <script src="~/js/modals/database-initialization.js" asp-append-version="true"></script>
}
</body>
</html>
